{
  "id": "neg-refresh-reuse",
  "source": "authcraft ADR 0008 B1",
  "description": "Reusing a rotated refresh token is invalid_grant and kills the family.",
  "steps": {
    "client_id": "spa",
    "redirect_uri": "https://app.example/cb",
    "code_challenge_method": "S256",
    "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
    "subject": "alice",
    "scope": "read",
    "now_authorize": 1000,
    "now_token": 1001,
    "now_refresh": 1002,
    "action": "refresh_reuse"
  },
  "expect": {
    "ok": false,
    "error": "invalid_grant",
    "phase": "refresh"
  }
}
