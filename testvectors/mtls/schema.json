{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authcraft.local/testvectors/mtls/schema.json",
  "title": "authcraft RFC 8705 mutual-TLS vector (ADR 0017)",
  "type": "object",
  "required": [
    "id",
    "source",
    "description",
    "steps",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "required": [
        "client_id",
        "redirect_uri",
        "code_verifier",
        "subject",
        "now_authorize",
        "now_token"
      ],
      "properties": {
        "client_id": {
          "type": "string"
        },
        "redirect_uri": {
          "type": "string"
        },
        "code_verifier": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "now_authorize": {
          "type": "integer"
        },
        "now_token": {
          "type": "integer"
        },
        "token_cert": {
          "enum": [
            "A",
            "B"
          ],
          "description": "Certificate (x-authcraft-certs) on the /token connection; absent means none."
        },
        "client_assertion": {
          "type": "string"
        },
        "dpop": {
          "type": "boolean",
          "description": "Also send a valid DPoP proof (generated by the runner)."
        },
        "userinfo_cert": {
          "enum": [
            "A",
            "B",
            null
          ],
          "description": "When present, call UserInfo with this certificate (null: none)."
        },
        "refresh_cert": {
          "enum": [
            "A",
            "B",
            null
          ],
          "description": "When present, refresh with this certificate (null: none)."
        }
      }
    },
    "expect": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "token",
            "userinfo",
            "refresh"
          ]
        },
        "error": {
          "type": "string"
        },
        "token_type": {
          "enum": [
            "Bearer",
            "DPoP"
          ]
        },
        "cnf_x5t": {
          "enum": [
            "A",
            "B",
            null
          ],
          "description": "Certificate whose x5t#S256 must appear in the (last) access token's cnf; null: none."
        }
      }
    }
  },
  "x-authcraft-certs": {
