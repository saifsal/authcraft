{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/authcraft/testvectors/oidc/schema.json",
  "title": "authcraft OIDC M2 test vector",
  "description": "OpenID Connect authorization-code cases for the oauth crate (ADR 0006).",
  "type": "object",
  "required": ["id", "source", "steps", "expect"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": { "type": "string" },
        "redirect_uri": { "type": "string" },
        "code_challenge_method": { "type": "string" },
        "code_verifier": { "type": "string" },
        "code_challenge": { "type": "string" },
        "subject": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "scope": { "type": "string" },
        "nonce": { "type": "string" },
        "state": { "type": "string" },
        "now_authorize": { "type": "integer" },
        "now_token": { "type": "integer" },
        "check_userinfo": { "type": "boolean", "default": false },
        "replay_token": { "type": "boolean", "default": false },
        "token_code_verifier": { "type": "string" },
        "token_redirect_uri": { "type": "string" },
        "token_client_id": { "type": "string" }
      }
    },
    "expect": {
      "type": "object",
      "required": ["ok"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "id_token": { "type": "boolean", "default": false },
        "error": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unauthorized_client",
            "invalid_grant",
            "unsupported_grant_type",
            "invalid_token",
            "server_error"
          ]
        },
        "phase": {
          "type": "string",
          "enum": ["authorize", "token", "userinfo"]
        }
      }
    }
  }
}
