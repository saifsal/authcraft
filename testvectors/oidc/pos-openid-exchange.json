{
  "id": "pos-openid-exchange",
  "source": "OIDC Core 1.0 §3.1 (authcraft ADR 0006)",
  "description": "openid scope with nonce yields access token + id_token with matching at_hash; UserInfo returns profile claims.",
  "steps": {
    "client_id": "spa",
    "redirect_uri": "https://app.example/cb",
    "code_challenge_method": "S256",
    "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
    "subject": "alice",
    "name": "Alice",
    "email": "alice@example.com",
    "scope": "openid profile email",
    "nonce": "n-0S6_WzA2Mj",
    "now_authorize": 1000,
    "now_token": 1001,
    "check_userinfo": true
  },
  "expect": {
    "ok": true,
    "id_token": true
  }
}
