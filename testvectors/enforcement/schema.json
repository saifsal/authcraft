{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authcraft.local/testvectors/enforcement/schema.json",
  "title": "authcraft PAR / sender-constraint enforcement vector (ADR 0018)",
  "type": "object",
  "required": [
    "id",
    "source",
    "description",
    "steps",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "required": [
        "client_id",
        "code_verifier",
        "subject",
        "now_authorize",
        "now_token"
      ],
      "properties": {
        "client_id": {
          "enum": [
            "spa",
            "par-only",
            "dpop-only",
            "mtls-only"
          ]
        },
        "code_verifier": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "now_authorize": {
          "type": "integer"
        },
        "now_token": {
          "type": "integer"
        },
        "use_par": {
          "type": "boolean",
          "description": "Push parameters to /par, then authorize with request_uri."
        },
        "dpop": {
          "type": "boolean",
          "description": "Send a valid DPoP proof (generated by the runner) to /token."
        },
        "token_cert": {
          "enum": [
            "A"
          ],
          "description": "Certificate A of testvectors/mtls/schema.json on the /token connection."
        },
        "server_require_sender_constrained": {
          "type": "boolean",
          "description": "ServerConfig.require_sender_constrained_tokens."
        }
      }
    },
    "expect": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "authorize",
            "token"
          ]
        },
        "error": {
          "type": "string"
        },
        "token_type": {
          "enum": [
            "Bearer",
            "DPoP"
          ]
        },
        "binding": {
          "enum": [
            "jkt",
            "x5t#S256",
            null
          ],
          "description": "cnf member of the access token; null: unbound."
        }
      }
    }
  },
  "x-authcraft-server": "Issuer https://auth.example. Public clients, all with redirect https://app.example/cb and scope read: spa (no flags), par-only (require_pushed_authorization_requests), dpop-only (dpop_bound_access_tokens), mtls-only (tls_client_certificate_bound_access_tokens)."
}
